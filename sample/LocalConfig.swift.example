// LocalConfig.swift.example
//
// Copy this file to `LocalConfig.swift` (same directory), then set your
// activation server. `LocalConfig.swift` is gitignored — your edits stay local.
//
// **How activation works (2.0.0):** the SDK activates by *attesting the app
// instance* — on a real device it uses Apple App Attest and bootstraps its
// licence automatically. There is no license key to paste.
//
// This sample is **prod-only**: run it on a real device with the App Attest
// capability provisioned for its bundle id. The simulator / CI can't produce
// production attestation; the SDK's sandbox-bootstrap path for those is covered
// in the repository's INTEGRATION.md, but is intentionally not wired into this
// sample. Sign up at https://octetproof.com.
//
// The sample reads `LocalConfig.licenseKey` and `LocalConfig.activationServerUrl`
// via plain Swift symbol resolution; skip this step and the build fails with
// `cannot find 'LocalConfig' in scope`, pointing right back here.

enum LocalConfig {

    /// Still **required** by `OctetConfig`, but as of 2.0.0 it is **not** the
    /// activation credential — the SDK activates by attestation, not by this
    /// value. Leave the placeholder as-is unless Octet issued you a specific one.
    static let licenseKey = "octet_live_PLACEHOLDER_NOT_USED_FOR_ACTIVATION"

    /// Activation server URL. Defaults to production; override only when running
    /// against your own activation backend (e.g. a LAN dev server). iOS ATS
    /// blocks plain `http://` to a non-localhost host without an
    /// `NSExceptionDomains` entry in `Info.plist` for that host.
    static let activationServerUrl = "https://api.octetproof.com"
}
