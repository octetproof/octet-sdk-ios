.DS_Store
.build/
.swiftpm/
Packages/
*.xcframework
*.xcframework.zip
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/

# Per-developer license key for the bundled sample app — copy
# LocalConfig.swift.example to LocalConfig.swift, paste your key,
# and the build picks it up. Never commit a real key.
sample/LocalConfig.swift

# Generated by `xcodegen generate` from sample/project.yml. Single
# source of truth is project.yml; the .xcodeproj is regenerated on
# every clone.
sample/*.xcodeproj/

sample/OctetSDK.xcframework
sample/OctetSDK.xcframework.zip
